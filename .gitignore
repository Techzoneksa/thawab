# Mirror of the Nitro server bundle at the repo root. Generated by
# `scripts/postbuild.mjs` after `vite build` so the conventional
# `node server/index.mjs` entry works on self-hosting Node.js hosts
# without needing them to read `.output/nitro.json`.
