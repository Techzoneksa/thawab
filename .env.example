# ثواب — متغيرات البيئة. انسخ إلى .env واملأ القيم. لا تضع أسراراً حقيقية هنا.

# قاعدة البيانات (PostgreSQL — إلزامي)
DATABASE_URL=postgresql://user:password@host:5432/thawab

# البيئة
NODE_ENV=development

# الأمان: اجعلها true في الإنتاج (كوكي الجلسة Secure). في التطوير على http اتركها false.
SESSION_COOKIE_SECURE=false

# الرابط العام للنظام — يُستخدم في روابط الإيميل (مثل رابط تعيين كلمة المرور)
APP_URL=https://thawab.jaadpro.com

# البريد الصادر (SMTP) — لازم لإرسال دعوات المستخدمين وروابط تعيين كلمة المرور.
# مثال إعداد بريد Hostinger:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465            # 465 (SSL) أو 587 (STARTTLS)
# SMTP_SECURE=true         # true مع 465، false مع 587
# SMTP_USER=no-reply@jaadpro.com
# SMTP_PASS=
# SMTP_FROM=جاد كلاود <no-reply@jaadpro.com>

# تكاملات مستقبلية (اختياري)
# SMS_PROVIDER_KEY=
# WHATSAPP_API_KEY=
